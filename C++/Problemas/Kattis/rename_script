#!/bin/bash

# Directory to process
TARGET_DIR="$1"

# Check if a directory argument was given and exists
if [[ -z "$TARGET_DIR" || ! -d "$TARGET_DIR" ]]; then
    echo "Usage: $0 <directory>"
    exit 1
fi

# Loop through immediate subdirectories
find "$TARGET_DIR" -mindepth 1 -maxdepth 1 -type d | while read -r dir; do
    dirname=$(basename "$dir")
    
    # Skip if the name has fewer than 2 characters
    if [[ ${#dirname} -lt 2 ]]; then
        echo "Skipping '$dirname' (too short)"
        continue
    fi

    # Remove the first character
    new_name="${dirname:3}"
    new_path="$(dirname "$dir")/$new_name"

    # Rename the directory
    mv "$dir" "$new_path"
    echo "Renamed: '$dirname' -> '$new_name'"
done
